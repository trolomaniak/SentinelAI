<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SentinelAI.Setup.Host</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>SentinelAI</Product>
    <Description>SentinelAI Windows deployment setup and maintenance</Description>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SentinelAI.Setup.Foundation/SentinelAI.Setup.Foundation.csproj" />
    <ProjectReference Include="../../shared/updates/SentinelAI.Updates.csproj" />
    <!-- Compile the existing authoritative trust/bootstrap implementation unchanged. -->
    <Compile Include="../../desktop/SentinelAI.Desktop/Services/WindowsCoreServices.cs" Link="ExistingCore/WindowsCoreServices.cs" />
    <Compile Include="../../desktop/SentinelAI.Desktop/Services/WindowsInstallationTrust.cs" Link="ExistingCore/WindowsInstallationTrust.cs" />
    <Compile Include="../../desktop/SentinelAI.Desktop/Services/WindowsNativeCore.cs" Link="ExistingCore/WindowsNativeCore.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SetupPayloadPath)' != '' and '$(SetupTrustPath)' != '' and '$(SetupMetadataPath)' != ''">
    <EmbeddedResource Include="$(SetupPayloadPath)" LogicalName="SentinelAI.Setup.Payload" />
    <EmbeddedResource Include="$(SetupTrustPath)" LogicalName="SentinelAI.Setup.Trust" />
    <EmbeddedResource Include="$(SetupMetadataPath)" LogicalName="SentinelAI.Setup.Metadata" />
  </ItemGroup>
  <Target Name="ValidateSetupResourceInputs" BeforeTargets="PrepareForBuild"
          Condition="'$(SetupPayloadPath)' != '' or '$(SetupTrustPath)' != '' or '$(SetupMetadataPath)' != ''">
    <Error Condition="!Exists('$(SetupPayloadPath)') or !Exists('$(SetupTrustPath)') or !Exists('$(SetupMetadataPath)')" Text="Setup publish requires the complete payload, separate public trust and metadata inputs." />
  </Target>
</Project>
