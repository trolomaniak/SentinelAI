<Window x:Class="SentinelAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SentinelAI.Desktop.Views"
        Title="{Binding Title}" Width="1180" Height="780" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="SentinelAIMainWindow">
    <Window.Resources>
        <DataTemplate x:Key="PlaceholderTemplate"><views:PlaceholderPage /></DataTemplate>
        <DataTemplate x:Key="DevicesTemplate">
            <views:DevicesView DataContext="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate x:Key="AlertsTemplate">
            <views:AlertsView DataContext="{Binding Alerts, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate x:Key="RiskTemplate">
            <views:RiskView DataContext="{Binding Risk, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate x:Key="RiskRegisterTemplate">
            <views:RiskRegisterView DataContext="{Binding RiskRegister, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate x:Key="ReportsTemplate">
            <views:ReportsView DataContext="{Binding Reports, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate x:Key="SettingsTemplate">
            <views:SettingsView DataContext="{Binding License, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource NavigationBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="20,24,20,0">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource NavigationForegroundBrush}" />
                    <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Margin="0,6,0,0"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource NavigationSecondaryBrush}" />
                </StackPanel>
                <ListBox x:Name="NavigationList" Grid.Row="1" Margin="12,28,12,12"
                         ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Once"
                         AutomationProperties.AutomationId="NavigationList"
                         AutomationProperties.Name="Workspace navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="20,12,20,20">
                    <TextBlock Text="Local security workspace" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource NavigationSecondaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource NavigationSecondaryBrush}"
                               AutomationProperties.AutomationId="DesktopServiceStatus" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Core service: {0} · Agent service: {1}">
                                <Binding Path="ServiceStatus.CoreStatusText" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding Path="ServiceStatus.AgentStatusText" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServiceStatus, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="AuthenticationRow" Height="Auto" />
                <RowDefinition x:Name="PageRow" Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- MVP-3 pilot notice: monitoring continues whatever it says; hidden until sign-out on request. -->
            <Border x:Name="PilotNotice" Margin="0,0,0,16" Padding="16" CornerRadius="8" BorderThickness="2"
                    DataContext="{Binding Pilot, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}"
                    AutomationProperties.AutomationId="PilotNotice" AutomationProperties.Name="Pilot license notice">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNoticeVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding NoticeTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PilotNoticeTitle" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="PilotNoticeText" />
                    <TextBlock Text="{Binding ContactText}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="PilotNoticeContact" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Hide until sign-out" Click="OnHidePilotNotice" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="HidePilotNoticeButton" />
                    </WrapPanel>
                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Uninstall SentinelAI" Click="OnUninstallSentinelAi" HorizontalAlignment="Left"
                                IsEnabled="{Binding CanUninstall}" AutomationProperties.AutomationId="UninstallSentinelAiButton" />
                        <TextBlock Text="{Binding UninstallStatusText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   AutomationProperties.AutomationId="UninstallSentinelAiStatus" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <views:AuthenticationView x:Name="AuthenticationPanel" Grid.Row="1" Visibility="Collapsed" />
            <ContentControl x:Name="PageContent" Grid.Row="2" Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            </ContentControl>
            <Border Grid.Row="3" Margin="0,20,0,0" Padding="16" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Local Core" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CoreStatusText}" TextWrapping="Wrap" FontSize="12"
                                   Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Button x:Name="RefreshCoreButton" Grid.Column="1" Content="Check connection"
                            Command="{Binding RefreshCoreCommand}" Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="RefreshCoreButton" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
