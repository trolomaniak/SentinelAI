<UserControl x:Class="SentinelAI.Desktop.Views.RiskHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SentinelAI.Desktop.Localization"
             xmlns:views="clr-namespace:SentinelAI.Desktop.Views">
    <Expander Header="{Binding HistoryHeading}" AutomationProperties.AutomationId="RiskHistoryExpander">
        <StackPanel Margin="8,12,4,8">
            <WrapPanel Margin="0,0,0,8">
                <Label Content="{loc:T 'Period'}" Target="{Binding ElementName=HistoryPeriod}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="HistoryPeriod" AutomationProperties.AutomationId="RiskHistoryPeriod"
                          ItemsSource="{Binding HistoryPeriods}" DisplayMemberPath="Label" SelectedValuePath="Hours"
                          SelectedValue="{Binding HistoryPeriodHours, Mode=TwoWay}" MinWidth="112" />
            </WrapPanel>
            <TextBlock Text="{Binding HistoryStatusText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.AutomationId="RiskHistoryStatus" AutomationProperties.LiveSetting="Polite" />
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers><DataTrigger Binding="{Binding History}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{loc:T 'Each dot is a recorded score on the 0–100 scale.'}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <Grid Height="112">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,4,0">
                        <TextBlock Text="100" VerticalAlignment="Top" HorizontalAlignment="Right" />
                        <TextBlock Text="50" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Text="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                    </Grid>
                    <views:RiskHistoryChart Grid.Column="1" History="{Binding History}"
                                            AutomationProperties.AutomationId="RiskHistoryChart"
                                            AutomationProperties.Name="{loc:T 'Recorded risk scores over time'}"
                                            AutomationProperties.HelpText="{loc:T 'Each dot is a recorded score on the 0–100 scale.'}" />
                </Grid>
                <Grid Margin="28,4,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding History.StartText}" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding History.EndText}" TextWrapping="Wrap" TextAlignment="Right" />
                </Grid>
                <DataGrid Height="146" ItemsSource="{Binding History.Points}" SelectedItem="{Binding SelectedHistoryPoint, Mode=TwoWay}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.AutomationId="RiskHistoryTable"
                          AutomationProperties.Name="{loc:T 'Recorded risk measurements'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T 'Recorded at (UTC)'}" Binding="{Binding RecordedAtText}" Width="218" />
                        <DataGridTextColumn Header="{loc:T 'Recorded score'}" Binding="{Binding Score}" Width="SizeToHeader" />
                        <DataGridTextColumn Header="{loc:T 'Raw score'}" Binding="{Binding RawScoreText}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedHistoryPoint}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:T 'Selected measurement'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:T 'Observed changes may have influenced the score. Verify remediation separately.'}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding SelectedHistoryPoint.Details}" AutomationProperties.AutomationId="RiskHistoryDetails">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Expander>
</UserControl>
