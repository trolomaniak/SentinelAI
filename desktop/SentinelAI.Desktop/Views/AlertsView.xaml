<UserControl x:Class="SentinelAI.Desktop.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alerts="clr-namespace:SentinelAI.Desktop.Foundation;assembly=SentinelAI.Desktop.Foundation"
             AutomationProperties.AutomationId="AlertsView" SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <Style x:Key="AlertGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AlertGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="ReadOnlyAlertGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource AlertGridHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource AlertGridCellStyle}" />
        </Style>
        <DataTemplate x:Key="AlertFactTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,16,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding Label, StringFormat='AlertFact_{0}'}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="DetailActionsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="150" Margin="0,0,0,12"
                      AutomationProperties.AutomationId="AlertDetailActions">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsShowingDetail}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <WrapPanel>
                <Button Content="Back to alerts" Click="OnBack" Margin="0,0,8,8" AutomationProperties.AutomationId="BackToAlertsButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsSavingStatus}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        </Style.Triggers></Style>
                    </Button.Style>
                </Button>
                <Button Content="Refresh latest" Click="OnRefreshDetail" Margin="0,0,8,8" AutomationProperties.AutomationId="RefreshAlertDetailButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSavingStatus}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsLoadingDetail}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ComboBox Width="145" Padding="6" Margin="0,0,8,8" SelectedValue="{Binding ProposedStatus}" SelectedValuePath="Tag"
                          AutomationProperties.AutomationId="AlertProposedStatus" AutomationProperties.Name="Choose new alert status">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DetailState}" Value="{x:Static alerts:AlertDetailState.Ready}"><Setter Property="IsEnabled" Value="True" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingStatus}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsLoadingDetail}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                <DataTrigger Binding="{Binding NeedsDetailRefresh}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBoxItem Content="Open" Tag="open" />
                    <ComboBoxItem Content="Investigating" Tag="investigating" />
                    <ComboBoxItem Content="Accepted" Tag="accepted" />
                    <ComboBoxItem Content="Resolved" Tag="resolved" />
                </ComboBox>
                <Button Content="Save status" Click="OnSaveStatus" IsEnabled="{Binding CanSaveStatus}" Margin="0,0,8,8"
                        AutomationProperties.AutomationId="SaveAlertStatusButton" />
            </WrapPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <StackPanel x:Name="PageHeader">
                    <TextBlock Text="Alerts" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PageHeading" AutomationProperties.Name="Alerts" />
                    <TextBlock Text="Review tracked alerts and choose status changes explicitly. New positive observations can reopen resolved alerts."
                               Margin="0,10,0,16" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               AutomationProperties.AutomationId="AlertErrorText" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8"
                               AutomationProperties.AutomationId="AlertStatusMessage" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingDetail}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style>
                    </StackPanel.Style>
                    <StackPanel x:Name="ListToolbar">
                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Width="240" Margin="0,0,12,8">
                                <TextBlock Text="Endpoint" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding EndpointOptions}" SelectedItem="{Binding SelectedEndpoint}" DisplayMemberPath="DisplayName" Padding="6"
                                          AutomationProperties.AutomationId="AlertEndpointFilter" AutomationProperties.Name="Filter alerts by endpoint">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,12,8">
                                <TextBlock Text="Severity" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding SeverityFilter}" SelectedValuePath="Tag" Padding="6"
                                          AutomationProperties.AutomationId="AlertSeverityFilter" AutomationProperties.Name="Filter alerts by severity">
                                    <ComboBoxItem Content="All severities" Tag="{x:Static alerts:AlertSeverityFilter.All}" />
                                    <ComboBoxItem Content="Info" Tag="{x:Static alerts:AlertSeverityFilter.Info}" />
                                    <ComboBoxItem Content="Low" Tag="{x:Static alerts:AlertSeverityFilter.Low}" />
                                    <ComboBoxItem Content="Medium" Tag="{x:Static alerts:AlertSeverityFilter.Medium}" />
                                    <ComboBoxItem Content="High" Tag="{x:Static alerts:AlertSeverityFilter.High}" />
                                    <ComboBoxItem Content="Critical" Tag="{x:Static alerts:AlertSeverityFilter.Critical}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,12,8">
                                <TextBlock Text="Status" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding StatusFilter}" SelectedValuePath="Tag" Padding="6"
                                          AutomationProperties.AutomationId="AlertStatusFilter" AutomationProperties.Name="Filter alerts by status">
                                    <ComboBoxItem Content="All statuses" Tag="{x:Static alerts:AlertStatusFilter.All}" />
                                    <ComboBoxItem Content="Open" Tag="{x:Static alerts:AlertStatusFilter.Open}" />
                                    <ComboBoxItem Content="Investigating" Tag="{x:Static alerts:AlertStatusFilter.Investigating}" />
                                    <ComboBoxItem Content="Accepted" Tag="{x:Static alerts:AlertStatusFilter.Accepted}" />
                                    <ComboBoxItem Content="Resolved" Tag="{x:Static alerts:AlertStatusFilter.Resolved}" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Apply filters" Click="OnApplyFilters" IsEnabled="{Binding CanApplyFilters}" Margin="0,0,8,8"
                                    AutomationProperties.AutomationId="ApplyAlertFiltersButton" />
                            <Button Content="Refresh" Click="OnRefresh" IsEnabled="{Binding CanRefresh}" Margin="0,0,8,8"
                                    AutomationProperties.AutomationId="RefreshAlertsButton" />
                            <Button Content="Open alert" Click="OnOpenDetail" Margin="0,0,8,8" AutomationProperties.AutomationId="OpenAlertButton">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedAlert}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                    </Style.Triggers></Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="Filters changed. Apply to load matching alerts." TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.AutomationId="AlertPendingFilters">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding FiltersChanged}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ListStatusText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   AutomationProperties.AutomationId="AlertListStatus" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <!-- A finite viewport preserves real row recycling while the full page remains scrollable in short windows. -->
                    <DataGrid x:Name="AlertsGrid" Style="{StaticResource ReadOnlyAlertGridStyle}" Height="240"
                              ItemsSource="{Binding VisibleAlerts}" SelectedItem="{Binding SelectedAlert, Mode=TwoWay}"
                              MouseDoubleClick="OnRowDoubleClick" AutomationProperties.AutomationId="AlertsGrid" AutomationProperties.Name="Tracked alerts">
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style></DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointName}" Width="180" />
                            <DataGridTextColumn Header="Alert" Binding="{Binding Title}" Width="270" />
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="180" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding SeverityLabel}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="130" />
                            <DataGridTextColumn Header="First observed (UTC)" Binding="{Binding FirstObservedText}" Width="190" />
                            <DataGridTextColumn Header="Latest observed (UTC)" Binding="{Binding LastObservedText}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel x:Name="ListPaging" Margin="0,12,0,0">
                        <Button Content="Previous" Click="OnPreviousPage" IsEnabled="{Binding CanPreviousPage}" Margin="0,0,8,8"
                                AutomationProperties.AutomationId="PreviousAlertsPageButton" />
                        <Button Content="Next" Click="OnNextPage" IsEnabled="{Binding CanNextPage}" Margin="0,0,12,8"
                                AutomationProperties.AutomationId="NextAlertsPageButton" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="AlertsPageSummary">
                            <TextBlock.Text><MultiBinding StringFormat="Page {0} of {1} · {2} matching alerts">
                                <Binding Path="PageNumber" /><Binding Path="TotalPages" /><Binding Path="TotalAlerts" />
                            </MultiBinding></TextBlock.Text>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsShowingDetail}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding DetailStatusText}" TextWrapping="Wrap" Margin="0,0,0,16"
                               AutomationProperties.AutomationId="AlertDetailStatus" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding DetailState}" Value="{x:Static alerts:AlertDetailState.Ready}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Detail.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"
                                   AutomationProperties.AutomationId="AlertDetailTitle" />
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Detail.Facts}" ItemTemplate="{StaticResource AlertFactTemplate}"
                                              AutomationProperties.AutomationId="AlertDetailFacts" />
                                <TextBlock Text="Reason" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,8" />
                                <TextBlock Text="{Binding Detail.Reason}" TextWrapping="Wrap" Margin="0,0,0,16" AutomationProperties.AutomationId="AlertReason" />
                                <TextBlock Text="Recommended action" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,8" />
                                <TextBlock Text="{Binding Detail.RecommendedAction}" TextWrapping="Wrap" AutomationProperties.AutomationId="AlertRecommendation" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Typed evidence" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,12" />
                        <DataGrid x:Name="AlertEvidenceGrid" Style="{StaticResource ReadOnlyAlertGridStyle}" Height="200"
                                  ItemsSource="{Binding Detail.Evidence}" AutomationProperties.AutomationId="AlertEvidenceGrid" AutomationProperties.Name="Typed alert evidence">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Field" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Field}" AutomationProperties.AutomationId="AlertEvidenceField" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Type" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding TypeLabel}" AutomationProperties.AutomationId="AlertEvidenceType" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Value" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" AutomationProperties.AutomationId="AlertEvidenceValue" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Status history" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <TextBlock Text="{Binding Detail.HistoryDisclosure}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.AutomationId="AlertHistoryDisclosure" />
                        <DataGrid x:Name="AlertHistoryGrid" Style="{StaticResource ReadOnlyAlertGridStyle}" Height="240"
                                  ItemsSource="{Binding Detail.History}" AutomationProperties.AutomationId="AlertHistoryGrid" AutomationProperties.Name="Alert status history">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Change type" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding ChangeType}" AutomationProperties.AutomationId="AlertHistoryChangeType" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Previous status" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding PreviousStatus}" AutomationProperties.AutomationId="AlertHistoryPreviousStatus" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="AlertHistoryStatus" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Changed (UTC)" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding ChangedUtcText}" AutomationProperties.AutomationId="AlertHistoryChangedUtc" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actor" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding ChangedBy}" AutomationProperties.AutomationId="AlertHistoryChangedBy" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
