<UserControl xmlns:loc="clr-namespace:SentinelAI.Desktop.Localization" x:Class="SentinelAI.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:foundation="clr-namespace:SentinelAI.Desktop.Foundation;assembly=SentinelAI.Desktop.Foundation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="PageHeading" />
            <TextBlock Text="{loc:T 'Review computers, investigate alerts, prioritize findings and save a local report.'}"
                       Margin="0,10,0,20" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <Button Content="{loc:T 'Devices'}" HorizontalAlignment="Left"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static foundation:PageId.Devices}" AutomationProperties.AutomationId="OverviewDevicesButton" />
                    <TextBlock Text="{loc:T 'Endpoint inventory and connection health.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <Button Content="{loc:T 'Alerts'}" HorizontalAlignment="Left"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static foundation:PageId.Alerts}" AutomationProperties.AutomationId="OverviewAlertsButton" />
                    <TextBlock Text="{loc:T 'Security alerts and incident review.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <Button Content="{loc:T 'Risk'}" HorizontalAlignment="Left"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static foundation:PageId.Risk}" AutomationProperties.AutomationId="OverviewRiskButton" />
                    <TextBlock Text="{loc:T 'Organization and endpoint risk.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <Button Content="{loc:T 'Reports'}" HorizontalAlignment="Left"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static foundation:PageId.Reports}" AutomationProperties.AutomationId="OverviewReportsButton" />
                    <TextBlock Text="{loc:T 'Local security reports.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:T 'Check observation times and coverage when reviewing results. An empty alert list does not establish that a computer is secure.'}"
                       TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
