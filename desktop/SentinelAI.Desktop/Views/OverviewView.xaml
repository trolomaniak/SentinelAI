<UserControl x:Class="SentinelAI.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:foundation="clr-namespace:SentinelAI.Desktop.Foundation;assembly=SentinelAI.Desktop.Foundation"
             xmlns:loc="clr-namespace:SentinelAI.Desktop.Localization"
             AutomationProperties.AutomationId="OverviewView">
    <UserControl.Resources>
        <Style x:Key="Wrapped" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Wrapped}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource Wrapped}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionData" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Wrapped}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ShortcutRow" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Shortcut" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"
                  AutomationProperties.AutomationId="OverviewScroll">
        <StackPanel Margin="0,0,4,8">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Style="{StaticResource Wrapped}"
                       AutomationProperties.AutomationId="PageHeading" AutomationProperties.Name="{Binding Title}" />
            <StackPanel DataContext="{Binding Overview, RelativeSource={RelativeSource AncestorType=Window}}">
                <WrapPanel Style="{StaticResource ShortcutRow}">
                    <Button Content="{loc:T 'Refresh'}" Style="{StaticResource Shortcut}" Click="OnRefresh"
                            IsEnabled="{Binding CanRefresh, FallbackValue=False}" AutomationProperties.AutomationId="OverviewRefreshButton" />
                    <Button Content="{loc:T 'Reports'}" Style="{StaticResource Shortcut}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static foundation:PageId.Reports}" AutomationProperties.AutomationId="OverviewReportsButton" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusText, FallbackValue={loc:T 'Operations overview is unavailable.'}}"
                           Style="{StaticResource SecondaryText}" Margin="0,0,0,10" AutomationProperties.AutomationId="OverviewStatus"
                           AutomationProperties.LiveSetting="Polite" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Priority alerts'}" Style="{StaticResource SectionHeading}" />
                        <ContentControl Content="{Binding Summary.PriorityAlerts}" Style="{StaticResource SectionData}"
                                        ContentTemplate="{StaticResource SectionTemplate}" AutomationProperties.AutomationId="OverviewPriorityAlerts" />
                        <WrapPanel Style="{StaticResource ShortcutRow}">
                            <Button Content="{loc:T 'Alerts'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.Alerts}" AutomationProperties.AutomationId="OverviewAlertsButton" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Endpoint coverage'}" Style="{StaticResource SectionHeading}" />
                        <ContentControl Content="{Binding Summary.Coverage}" Style="{StaticResource SectionData}"
                                        ContentTemplate="{StaticResource SectionTemplate}" AutomationProperties.AutomationId="OverviewCoverage" />
                        <WrapPanel Style="{StaticResource ShortcutRow}">
                            <Button Content="{loc:T 'Monitoring coverage'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.MonitoringCoverage}" AutomationProperties.AutomationId="OverviewCoverageButton" />
                            <Button Content="{loc:T 'Devices'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.Devices}" AutomationProperties.AutomationId="OverviewDevicesButton" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Notifications'}" Style="{StaticResource SectionHeading}" />
                        <ContentControl Content="{Binding Summary.UnreadNotifications}" Style="{StaticResource SectionData}"
                                        ContentTemplate="{StaticResource SectionTemplate}" AutomationProperties.AutomationId="OverviewUnreadNotifications" />
                        <WrapPanel Style="{StaticResource ShortcutRow}">
                            <Button Content="{loc:T 'Open Notifications'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.Notifications}" AutomationProperties.AutomationId="OverviewNotificationsButton" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Risk Register'}" Style="{StaticResource SectionHeading}" />
                        <ContentControl Content="{Binding Summary.RisksNeedingAttention}" Style="{StaticResource SectionData}"
                                        ContentTemplate="{StaticResource SectionTemplate}" AutomationProperties.AutomationId="OverviewRisks" />
                        <WrapPanel Style="{StaticResource ShortcutRow}">
                            <Button Content="{loc:T 'Open Risk Register'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.RiskRegister}" AutomationProperties.AutomationId="OverviewRiskRegisterButton" />
                            <Button Content="{loc:T 'Risk'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.Risk}" AutomationProperties.AutomationId="OverviewRiskButton" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Alert status changes in the last 24 hours'}" Style="{StaticResource SectionHeading}" />
                        <ContentControl Content="{Binding Summary.RecentAlertChanges}" Style="{StaticResource SectionData}"
                                        ContentTemplate="{StaticResource SectionTemplate}" AutomationProperties.AutomationId="OverviewRecentAlertChanges" />
                        <WrapPanel Style="{StaticResource ShortcutRow}">
                            <Button Content="{loc:T 'Alerts'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.Alerts}" AutomationProperties.AutomationId="OverviewAlertChangesButton" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Encrypted backups and recovery'}" Style="{StaticResource SectionHeading}" />
                        <ContentControl Content="{Binding Summary.Backup}" Style="{StaticResource SectionData}"
                                        ContentTemplate="{StaticResource SectionTemplate}" AutomationProperties.AutomationId="OverviewBackup" />
                        <WrapPanel Style="{StaticResource ShortcutRow}">
                            <Button Content="{loc:T 'Settings'}" Style="{StaticResource Shortcut}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static foundation:PageId.Settings}" AutomationProperties.AutomationId="OverviewBackupSettingsButton" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
