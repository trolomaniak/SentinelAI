<UserControl x:Class="SentinelAI.Desktop.Views.RiskRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:foundation="clr-namespace:SentinelAI.Desktop.Foundation;assembly=SentinelAI.Desktop.Foundation"
             AutomationProperties.AutomationId="RiskRegisterView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MultilineBox" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <DataTemplate x:Key="ChoiceTemplate" DataType="{x:Type foundation:RiskRegisterChoice}">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,12,24">
            <TextBlock Text="Risk Register" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DistinctionText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,4,0,12"
                       AutomationProperties.AutomationId="RiskRegisterDistinction" />

            <WrapPanel x:Name="FilterBar" AutomationProperties.AutomationId="RiskRegisterFilters">
                <ComboBox Width="200" Margin="0,0,8,8" ItemsSource="{x:Static foundation:RiskRegisterViewModel.StatusFilters}"
                          DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}"
                          AutomationProperties.Name="Status" AutomationProperties.AutomationId="RiskRegisterStatusFilter" />
                <ComboBox Width="180" Margin="0,0,8,8" ItemsSource="{x:Static foundation:RiskRegisterViewModel.TreatmentFilters}"
                          DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding TreatmentFilter}"
                          AutomationProperties.Name="Treatment" AutomationProperties.AutomationId="RiskRegisterTreatmentFilter" />
                <ComboBox Width="180" Margin="0,0,8,8" ItemsSource="{x:Static foundation:RiskRegisterViewModel.LevelFilters}"
                          DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding LevelFilter}"
                          AutomationProperties.Name="Residual level" AutomationProperties.AutomationId="RiskRegisterLevelFilter" />
                <CheckBox Content="Needing attention only" IsChecked="{Binding AttentionOnly}" VerticalAlignment="Center" Margin="0,0,12,8"
                          AutomationProperties.AutomationId="RiskRegisterAttentionFilter" />
                <Button Content="Apply filters" Click="OnApplyFilters" Margin="0,0,8,8" Padding="12,4" AutomationProperties.AutomationId="RiskRegisterApplyFilters" />
                <Button Content="Refresh" Click="OnRefresh" Margin="0,0,8,8" Padding="12,4" AutomationProperties.AutomationId="RiskRegisterRefresh" />
                <Button Content="New risk" Click="OnNewRisk" Margin="0,0,8,8" Padding="12,4" AutomationProperties.AutomationId="RiskRegisterNew" />
            </WrapPanel>
            <TextBlock Text="{Binding CountsText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,2" AutomationProperties.AutomationId="RiskRegisterCounts" />
            <TextBlock Text="{Binding ListText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,0,0,8" AutomationProperties.AutomationId="RiskRegisterListText" />
            <DataGrid x:Name="RegisterGrid" Height="260" ItemsSource="{Binding Rows, Mode=OneWay}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                      AutomationProperties.Name="Risk Register records" AutomationProperties.AutomationId="RiskRegisterGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Risk" Binding="{Binding Reference}" Width="80" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Residual" Binding="{Binding Residual}" Width="110" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Treatment" Binding="{Binding Treatment}" Width="100" />
                    <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*" />
                    <DataGridTextColumn Header="Next review" Binding="{Binding ReviewDate}" Width="100" />
                    <DataGridTextColumn Header="Needs attention" Binding="{Binding Attention}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                <Button Content="Previous" Click="OnPreviousPage" IsEnabled="{Binding CanPreviousPage, Mode=OneWay}" Margin="0,0,8,0" Padding="12,4"
                        AutomationProperties.AutomationId="RiskRegisterPrevious" />
                <Button Content="Next" Click="OnNextPage" IsEnabled="{Binding CanNextPage, Mode=OneWay}" Padding="12,4" AutomationProperties.AutomationId="RiskRegisterNext" />
            </StackPanel>

            <Border x:Name="Editor" Visibility="{Binding IsEditing, Mode=OneWay, Converter={StaticResource VisibleWhen}}" Padding="16"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"
                    AutomationProperties.AutomationId="RiskRegisterEditor">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="RiskRegisterEditorTitle" />
                    <TextBlock Text="{Binding FlagsText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="RiskRegisterFlags" />
                    <TextBlock Text="{Binding RecordText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,4,0,0" AutomationProperties.AutomationId="RiskRegisterRecord" />

                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                             AutomationProperties.Name="Title" AutomationProperties.AutomationId="RiskRegisterTitle" />
                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Style="{StaticResource MultilineBox}"
                             IsEnabled="{Binding CanEdit, Mode=OneWay}" AutomationProperties.Name="Description" />
                    <TextBlock Text="Owner (a named person or role; required to accept a risk)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                             AutomationProperties.Name="Owner" AutomationProperties.AutomationId="RiskRegisterOwner" />

                    <TextBlock Text="Inherent risk (before existing controls)" Style="{StaticResource FieldLabel}" />
                    <WrapPanel>
                        <TextBlock Text="Likelihood" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="60" ItemsSource="{x:Static foundation:RiskRegisterViewModel.Scale}" SelectedItem="{Binding Likelihood}"
                                  IsEnabled="{Binding CanEdit, Mode=OneWay}" Margin="0,0,16,0" AutomationProperties.Name="Likelihood" />
                        <TextBlock Text="Impact" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="60" ItemsSource="{x:Static foundation:RiskRegisterViewModel.Scale}" SelectedItem="{Binding Impact}"
                                  IsEnabled="{Binding CanEdit, Mode=OneWay}" Margin="0,0,16,0" AutomationProperties.Name="Impact" />
                        <TextBlock Text="{Binding InherentText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="RiskRegisterInherent" />
                    </WrapPanel>
                    <TextBlock Text="Existing controls" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Controls, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Style="{StaticResource MultilineBox}"
                             IsEnabled="{Binding CanEdit, Mode=OneWay}" AutomationProperties.Name="Existing controls" />
                    <TextBlock Text="Residual risk (with existing controls)" Style="{StaticResource FieldLabel}" />
                    <WrapPanel>
                        <TextBlock Text="Likelihood" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="60" ItemsSource="{x:Static foundation:RiskRegisterViewModel.Scale}" SelectedItem="{Binding ResidualLikelihood}"
                                  IsEnabled="{Binding CanEdit, Mode=OneWay}" Margin="0,0,16,0" AutomationProperties.Name="Residual likelihood" />
                        <TextBlock Text="Impact" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="60" ItemsSource="{x:Static foundation:RiskRegisterViewModel.Scale}" SelectedItem="{Binding ResidualImpact}"
                                  IsEnabled="{Binding CanEdit, Mode=OneWay}" Margin="0,0,16,0" AutomationProperties.Name="Residual impact" />
                        <TextBlock Text="{Binding ResidualText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="RiskRegisterResidual" />
                    </WrapPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Treatment" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox Width="180" ItemsSource="{x:Static foundation:RiskRegisterViewModel.Treatments}" DisplayMemberPath="Text"
                                      SelectedValuePath="Value" SelectedValue="{Binding Treatment}" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                                      AutomationProperties.Name="Treatment" AutomationProperties.AutomationId="RiskRegisterTreatment" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox Width="160" ItemsSource="{x:Static foundation:RiskRegisterViewModel.Statuses}" DisplayMemberPath="Text"
                                      SelectedValuePath="Value" SelectedValue="{Binding Status}" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                                      AutomationProperties.Name="Status" AutomationProperties.AutomationId="RiskRegisterStatus" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Target date" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding TargetDate}" IsEnabled="{Binding CanEdit, Mode=OneWay}" AutomationProperties.Name="Target date" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Next review" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding ReviewDate}" IsEnabled="{Binding CanEdit, Mode=OneWay}" AutomationProperties.Name="Next review" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding IsAcceptance, Mode=OneWay, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="RiskRegisterAcceptance">
                        <TextBlock Text="Why the risk is accepted" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AcceptanceRationale, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Style="{StaticResource MultilineBox}"
                                 IsEnabled="{Binding CanEdit, Mode=OneWay}" AutomationProperties.Name="Why the risk is accepted" />
                        <TextBlock Text="Acceptance expires on (at most one year ahead)" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding AcceptanceExpiresOn}" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                                    AutomationProperties.Name="Acceptance expires on" />
                    </StackPanel>

                    <TextBlock Text="Linked computers" Style="{StaticResource FieldLabel}" />
                    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="6">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding EndpointChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                                          AutomationProperties.AutomationId="RiskRegisterComputers" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                        <TextBlock Text="Linked alerts" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Show alerts of the ticked computers" Click="OnLoadAlerts" Padding="10,2" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                                AutomationProperties.AutomationId="RiskRegisterLoadAlerts" />
                    </StackPanel>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="6">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AlertChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                                          AutomationProperties.AutomationId="RiskRegisterAlerts" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="Tickets (references, one per line)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TicketsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineBox}" IsEnabled="{Binding CanEdit, Mode=OneWay}"
                             AutomationProperties.Name="Tickets" />
                    <TextBlock Text="Note for the history (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Style="{StaticResource MultilineBox}"
                             IsEnabled="{Binding CanEdit, Mode=OneWay}" AutomationProperties.Name="Note for the history" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Click="OnSave" IsEnabled="{Binding CanSave, Mode=OneWay}" Padding="16,4" Margin="0,0,8,0" IsDefault="False"
                                AutomationProperties.AutomationId="RiskRegisterSave" />
                        <Button Content="Cancel" Click="OnCancel" Padding="16,4" AutomationProperties.AutomationId="RiskRegisterCancel" />
                    </StackPanel>
                    <TextBlock Text="{Binding MessageText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="RiskRegisterMessage" />
                    <TextBlock Text="{Binding ValidationText, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"
                               AutomationProperties.AutomationId="RiskRegisterValidation" />

                    <StackPanel Visibility="{Binding CanReview, Mode=OneWay, Converter={StaticResource VisibleWhen}}" Margin="0,16,0,0"
                                AutomationProperties.AutomationId="RiskRegisterReview">
                        <TextBlock Text="Record a review" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Confirms the record still describes the risk and sets when it is next due." Style="{StaticResource Hint}" />
                        <TextBlock Text="Next review on" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding NextReviewDate}" HorizontalAlignment="Left" AutomationProperties.Name="Next review on" />
                        <TextBlock Text="Review note (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Style="{StaticResource MultilineBox}"
                                 AutomationProperties.Name="Review note" />
                        <Button Content="Record review" Click="OnReview" HorizontalAlignment="Left" Padding="16,4" Margin="0,8,0,0"
                                AutomationProperties.AutomationId="RiskRegisterRecordReview" />
                    </StackPanel>

                    <TextBlock Text="History" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding HistoryRows, Mode=OneWay}" AutomationProperties.AutomationId="RiskRegisterHistory">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
